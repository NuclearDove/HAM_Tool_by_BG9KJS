{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./js",
    "rootDir": "./js",
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": ["js/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}